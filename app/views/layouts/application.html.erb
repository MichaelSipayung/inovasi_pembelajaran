<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Inovasi Pembelajaran" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Inovasi Pembelajaran">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-white text-gray-800 antialiased font-sans">
    <!-- Navbar -->
    <header class="bg-blue-800 text-white p-4 shadow-md flex justify-between items-center">
      <h1 class="text-xl font-bold">Algoritma & Pemrograman</h1>
      <div>
        <% if user_signed_in? %>
          <span class="mr-4">Halo, <%= current_user.email %></span>
          <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: "bg-red-500 px-3 py-1 rounded text-sm hover:bg-red-600" %>
        <% else %>
          <%= link_to 'Login', new_user_session_path, class: "bg-green-500 px-4 py-2 rounded font-bold hover:bg-green-600" %>
        <% end %>
      </div>
    </header>

    <!-- Main Layout -->
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="w-72 bg-gray-50 border-r border-gray-300 flex-shrink-0 min-h-screen">
        <div class="p-4 sticky top-0 max-h-screen overflow-y-auto">
          
          <!-- Header Sidebar & Tombol Tambah (Hanya untuk Dosen) -->
          <div class="flex justify-between items-center mb-6 border-b border-gray-300 pb-3">
            <h2 class="text-lg font-extrabold text-gray-800">Daftar Materi</h2>
            
            <% if current_user && current_user.dosen? %>
              <div class="flex gap-2">
                <%= link_to '+ Bab', new_topic_path, class: "text-xs font-bold bg-blue-100 text-blue-700 px-2 py-1 rounded hover:bg-blue-200 transition", title: "Tambah Bab Baru" %>
                <%= link_to '+ Materi', new_lesson_path, class: "text-xs font-bold bg-green-100 text-green-700 px-2 py-1 rounded hover:bg-green-200 transition", title: "Tambah Materi Baru" %>
              </div>
            <% end %>
          </div>

          <!-- Looping Data dari Database -->
          <ul class="space-y-6 text-sm">
            <% @sidebar_topics.each do |topic| %>
              <li>
                <!-- Nama Bab -->
                <div class="flex justify-between items-center mb-2">
                  <span class="font-bold text-gray-500 uppercase tracking-wider text-xs">
                    <%= topic.title %>
                  </span>
                  <!-- Tombol Edit Bab (Hanya Dosen) -->
                  <% if current_user && current_user.dosen? %>
                    <%= link_to 'Edit', edit_topic_path(topic), class: "text-[10px] text-gray-400 hover:text-blue-600" %>
                  <% end %>
                </div>

                <!-- Daftar Materi di dalam Bab tersebut -->
                <ul class="space-y-1 pl-3 border-l-2 border-gray-200">
                  <% topic.lessons.each do |lesson| %>
                    <li>
                      <%# Logika untuk menandai materi mana yang sedang aktif dibaca %>
                      <% is_active = current_page?(lesson_path(lesson)) %>
                      
                      <%= link_to lesson.title, lesson_path(lesson), 
                          class: "block py-1.5 px-3 rounded-r-lg transition-colors duration-200 
                                  #{is_active ? 'bg-blue-100 text-blue-800 font-bold border-l-4 border-blue-600 -ml-[14px] pl-[15px]' : 'text-gray-600 hover:bg-gray-200 hover:text-gray-900'}" %>
                    </li>
                  <% end %>
                </ul>
              </li>
            <% end %>
          </ul>

        </div>
      </aside>

      <!-- Main Content Area -->
      <main class="flex-1 p-8 overflow-y-auto">
        <%= yield %> <!-- Tempat halaman materi dirender -->
      </main>
    </div>
  </body>
</html>
