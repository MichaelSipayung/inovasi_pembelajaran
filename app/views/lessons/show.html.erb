<div class="max-w-4xl mx-auto">
  
  <!-- PANEL KONTROL DOSEN (Hanya muncul jika login sebagai dosen) -->
<!-- PANEL KONTROL DOSEN (Hanya muncul jika login sebagai dosen) -->
<% if current_user && current_user.dosen? %>
  <div class="bg-yellow-50 border border-yellow-300 rounded-xl p-6 mb-8 shadow-sm">
    <h3 class="text-lg font-bold text-yellow-900 border-b border-yellow-200 pb-2 mb-4">🛠️ Panel Kontrol Dosen</h3>
    
    <div class="flex flex-wrap gap-3 mb-6">
      <%= link_to '+ Tambah Soal Kuis', new_lesson_question_path(@lesson), class: "bg-green-600 hover:bg-green-700 text-white text-sm font-bold py-2 px-4 rounded shadow transition-colors" %>
      <%= link_to '✏️ Edit Materi Ini', edit_lesson_path(@lesson), class: "bg-yellow-600 hover:bg-yellow-700 text-white text-sm font-bold py-2 px-4 rounded shadow transition-colors" %>
      <%= button_to '🗑️ Hapus Materi', @lesson, method: :delete, form: { data: { turbo_confirm: 'Hapus materi beserta seluruh soal kuisnya?' } }, class: "bg-red-600 hover:bg-red-700 text-white text-sm font-bold py-2 px-4 rounded shadow transition-colors" %>
    </div>

    <!-- Daftar Soal Kuis Khusus Dosen -->
    <% if @lesson.questions.any? %>
      <div class="bg-white rounded-lg border border-yellow-200 p-4">
        <h4 class="font-bold text-gray-700 mb-3">Daftar Soal Kuis pada Materi Ini:</h4>
        <ul class="space-y-3">
          <% @lesson.questions.each_with_index do |q, index| %>
            <li class="flex justify-between items-start border-b pb-2 text-sm">
              <div class="text-gray-800 font-medium">
                <%= index + 1 %>. <%= q.content %> <br>
                <span class="text-green-600 font-bold text-xs mt-1 block">Kunci: <%= q.correct_answer %></span>
              </div>
              <div class="flex gap-2 ml-4">
                <%= link_to 'Edit', edit_lesson_question_path(@lesson, q), class: "text-blue-600 hover:underline" %>
                <%= button_to 'Hapus', lesson_question_path(@lesson, q), method: :delete, form: { data: { turbo_confirm: 'Hapus soal ini?' } }, class: "text-red-600 hover:underline" %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
<% end %>
  <!-- AKHIR PANEL KONTROL DOSEN -->

  <!-- Judul Materi -->
  <h1 class="text-3xl font-bold mb-6 text-blue-900"><%= @lesson.title %></h1>

  <!-- Konten Materi (Teks, Gambar, Penjelasan Algoritma) -->
  <div class="prose max-w-none mb-10">
    <%= @lesson.content %>
  </div>

  <!-- Integrasi Compiler Explorer -->
  <% if @lesson.compiler_url.present? %>
    <div class="mb-10">
      <h2 class="text-xl font-bold mb-3 border-b-2 border-gray-200 pb-2">Praktik Kode (Compiler Explorer)</h2>
      <div class="w-full h-[500px] border-2 border-gray-300 rounded-lg overflow-hidden bg-gray-50">
        <iframe 
          src="<%= @lesson.compiler_url %>" 
          width="100%" 
          height="100%" 
          frameborder="0"
          allowfullscreen>
        </iframe>
      </div>
      <p class="text-sm text-gray-500 mt-2">Silakan ubah kode di atas dan lihat hasil eksekusinya secara langsung.</p>
    </div>
  <% end %>

  <!-- Integrasi Tugas HackerRank -->
  <% if @lesson.hackerrank_url.present? %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 flex flex-col items-center justify-center shadow-sm">
      <h2 class="text-2xl font-bold text-blue-800 mb-2">Tugas Mandiri</h2>
      <p class="text-gray-700 mb-4 text-center">Uji pemahaman algoritma Anda dengan menyelesaikan kasus uji di HackerRank.</p>
      
      <a href="<%= @lesson.hackerrank_url %>" target="_blank" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-full shadow-lg transition duration-300 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        Kerjakan di HackerRank
      </a>
    </div>
  <% end %>

  <!-- ================= AREA KUIS ================= -->
  <div class="mt-12 bg-white border border-gray-200 rounded-xl shadow-sm p-8">
    <h2 class="text-2xl font-bold text-gray-800 mb-6 border-b pb-4">Kuis Evaluasi Materi</h2>

    <% if @lesson.questions.any? %>
      
      <%# Cek apakah mahasiswa ini sudah pernah mengerjakan %>
      <% submission = @lesson.submissions.find_by(user: current_user) %>
      
      <% if submission %>
        <!-- Tampilan Jika Sudah Mengerjakan (Terkunci) -->
        <div class="bg-green-50 border-l-4 border-green-500 p-6 rounded-r-lg">
          <h3 class="text-xl font-bold text-green-800">Kuis Selesai!</h3>
          <p class="text-green-700 mt-2">Anda telah menyelesaikan evaluasi untuk materi ini dan tidak dapat mengulangnya.</p>
          <div class="mt-4 text-4xl font-extrabold text-green-900">
            Nilai Anda: <%= submission.score %> / 100
          </div>
        </div>
      
      <% else %>
        <!-- Tampilan Form Kuis (Jika Belum Mengerjakan) -->
        <div class="bg-blue-50 text-blue-800 p-4 rounded-lg mb-6 text-sm font-semibold">
          Perhatian: Kuis ini hanya dapat dikerjakan SATU KALI. Pastikan jawaban Anda sudah benar sebelum menekan tombol submit.
        </div>

        <%= form_with url: submit_quiz_lesson_path(@lesson), method: :post, local: true, class: "space-y-8" do |f| %>
          <% @lesson.questions.each_with_index do |question, index| %>
            <div class="bg-gray-50 p-6 rounded-lg border border-gray-100">
              <p class="font-bold text-gray-800 mb-4"><%= index + 1 %>. <%= question.content %></p>
              
              <div class="space-y-3">
                <% ['A', 'B', 'C', 'D'].each do |opt| %>
                  <label class="flex items-center space-x-3 cursor-pointer p-2 rounded hover:bg-white transition">
                    <%= radio_button_tag "answers[#{question.id}]", opt, false, class: "w-5 h-5 text-blue-600 focus:ring-blue-500", required: true %>
                    <span class="text-gray-700 font-medium">
                      <span class="font-bold mr-2"><%= opt %>.</span>
                      <%= question.send("option_#{opt.downcase}") %>
                    </span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>

          <div class="pt-4 text-right">
            <%= f.submit "Kirim Jawaban Kuis", class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg shadow-md cursor-pointer transition", data: { turbo_confirm: "Yakin ingin mengumpulkan? Anda tidak bisa mengulangi kuis ini." } %>
          </div>
        <% end %>
      <% end %>

    <% else %>
      <p class="text-gray-500 italic">Belum ada kuis untuk materi ini.</p>
    <% end %>
  </div>

</div>