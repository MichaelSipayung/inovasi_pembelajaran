<%= form_with(model: lesson, class: "space-y-6 max-w-4xl mx-auto bg-white p-8 rounded-xl shadow-md border border-gray-100") do |form| %>
  
  <% if lesson.errors.any? %>
    <div class="bg-red-50 text-red-700 p-4 rounded-lg mb-6 border border-red-200">
      <h2 class="font-bold mb-2"><%= pluralize(lesson.errors.count, "error") %> mencegah materi ini disimpan:</h2>
      <ul class="list-disc pl-5">
        <% lesson.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Input Judul Materi -->
  <div class="space-y-1">
    <%= form.label :title, "Judul Materi", class: "block text-sm font-semibold text-gray-700" %>
    <%= form.text_field :title, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors", placeholder: "Contoh: Memahami Logika Percabangan (If-Else)" %>
  </div>

  <!-- Dropdown Pilihan Bab (Topic) -->
  <div class="space-y-1">
    <%= form.label :topic_id, "Bab / Topik Utama", class: "block text-sm font-semibold text-gray-700" %>
    <%# Ini yang membuat dropdown muncul, mengambil data dari tabel Topic %>
    <%= form.collection_select :topic_id, Topic.all, :id, :title, { prompt: "-- Pilih Bab Materi --" }, { class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white" } %>
  </div>

  <!-- Rich Text Editor untuk Konten (Membutuhkan ActionText) -->
  <div class="space-y-1">
    <%= form.label :content, "Isi Materi Lengkap", class: "block text-sm font-semibold text-gray-700" %>
    <div class="border border-gray-300 rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-blue-500 focus-within:border-blue-500">
      <%= form.rich_text_area :content, class: "min-h-[300px] p-4 bg-gray-50 focus:bg-white outline-none prose max-w-none" %>
    </div>
  </div>

  <!-- Input URL Compiler Explorer -->
  <div class="space-y-1">
    <%= form.label :compiler_url, "URL Embed Compiler Explorer (Opsional)", class: "block text-sm font-semibold text-gray-700" %>
    <%= form.text_field :compiler_url, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono text-sm", placeholder: "https://godbolt.org/e?hideEditorToolbars=true#..." %>
    <p class="text-xs text-gray-500 mt-1">Gunakan fitur 'Share' -> 'Embed' di Compiler Explorer untuk mendapatkan link ini.</p>
  </div>

  <!-- Input URL HackerRank -->
  <div class="space-y-1">
    <%= form.label :hackerrank_url, "URL Tugas HackerRank (Opsional)", class: "block text-sm font-semibold text-gray-700" %>
    <%= form.text_field :hackerrank_url, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono text-sm", placeholder: "https://www.hackerrank.com/challenges/..." %>
    <p class="text-xs text-gray-500 mt-1">Tautan menuju tugas spesifik atau kontes yang Anda buat di HackerRank.</p>
  </div>

  <!-- Tombol Simpan -->
  <div class="pt-4 flex items-center justify-between border-t border-gray-200">
    <%= link_to "Batal", lessons_path, class: "text-gray-600 hover:text-gray-900 font-medium px-4 py-2" %>
    <%= form.submit "Simpan Materi Pembelajaran", class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-lg cursor-pointer transition-colors" %>
  </div>

<% end %>