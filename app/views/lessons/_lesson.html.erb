<div id="<%= dom_id lesson %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Topic:</strong>
    <%= lesson.topic_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= lesson.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Compiler url:</strong>
    <%= lesson.compiler_url %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Hackerrank url:</strong>
    <%= lesson.hackerrank_url %>
  </div>
</div>
