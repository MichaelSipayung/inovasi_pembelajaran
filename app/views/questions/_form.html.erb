<%= form_with(model: [@lesson, @question], class: "space-y-6 bg-white p-8 rounded-xl border border-gray-200 shadow-sm max-w-3xl mx-auto mt-10") do |form| %>
  
  <h2 class="text-2xl font-bold text-blue-900 border-b pb-4 mb-6">
    <%= @question.new_record? ? "Tambah Soal Kuis Baru" : "Edit Soal Kuis" %>
  </h2>

  <!-- Pertanyaan -->
  <div class="space-y-2">
    <%= form.label :content, "Pertanyaan", class: "block font-bold text-gray-700" %>
    <%= form.text_area :content, rows: 3, class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500", required: true %>
  </div>

  <!-- Pilihan Ganda -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :option_a, "Pilihan A", class: "block text-sm font-bold text-gray-700 mb-1" %>
      <%= form.text_field :option_a, class: "w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500", required: true %>
    </div>
    <div>
      <%= form.label :option_b, "Pilihan B", class: "block text-sm font-bold text-gray-700 mb-1" %>
      <%= form.text_field :option_b, class: "w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500", required: true %>
    </div>
    <div>
      <%= form.label :option_c, "Pilihan C", class: "block text-sm font-bold text-gray-700 mb-1" %>
      <%= form.text_field :option_c, class: "w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500", required: true %>
    </div>
    <div>
      <%= form.label :option_d, "Pilihan D", class: "block text-sm font-bold text-gray-700 mb-1" %>
      <%= form.text_field :option_d, class: "w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500", required: true %>
    </div>
  </div>

  <!-- Kunci Jawaban -->
  <div class="space-y-2 pt-4 border-t border-gray-100">
    <%= form.label :correct_answer, "Kunci Jawaban Benar", class: "block font-bold text-gray-700" %>
    <%= form.select :correct_answer, ['A', 'B', 'C', 'D'], { prompt: "-- Pilih Jawaban Benar --" }, { class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 bg-green-50 font-bold", required: true } %>
  </div>

  <!-- Tombol Aksi -->
  <div class="flex justify-between items-center pt-6">
    <%= link_to "Batal", lesson_path(@lesson), class: "text-gray-500 hover:text-gray-800 font-medium" %>
    <%= form.submit "Simpan Soal", class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-lg cursor-pointer" %>
  </div>
<% end %>